{
  "name": "thursday-dinner-concierge",
  "version": "0.1.0",
  "description": "A concierge agent with sourcing, comparison and venue-coordination subagents that turns one sentence into a confirmed, paid, on-policy booking, with every consequential action gated by a booker-approved proposal.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env src/cli/demo.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:pg": "node --test --test-reporter=spec --test-concurrency=1 test/*.test.ts",
    "evals": "ANDE_LLM_MODE=${ANDE_LLM_MODE:-replay} node --env-file-if-exists=.env evals/run.ts && node evals/users.ts",
    "fuzz": "node evals/fuzz.ts 300",
    "evals:ranking": "node evals/rank.ts",
    "evals:users": "node evals/users.ts",
    "evals:live": "ANDE_LLM_MODE=record node --env-file-if-exists=.env evals/run.ts && node web/build.mjs",
    "llm:check": "node --env-file-if-exists=.env evals/check.ts",
    "judge:calibrate": "node --env-file-if-exists=.env evals/calibrate.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node web/build.mjs",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "site:check": "node scripts/site-check.mjs",
    "server:dev": "npx wrangler dev --config server/wrangler.toml",
    "server:deploy": "npx wrangler deploy --config server/wrangler.toml"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.0"
  }
}
